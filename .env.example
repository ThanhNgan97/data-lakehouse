# Data Lakehouse environment contract
# Copy to .env and configure values for the target machine.
# Never commit real credentials.

AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_UID=
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
HADOOP_HOME=
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_BUCKET_NAME=university-lakehouse
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=
MINIO_SECRET_KEY=CHANGE_ME
MOCK_API_KEY=CHANGE_ME
NESSIE_API_URL=http://localhost:19120/api/v1
PG_DATABASE=university_db
PG_HOST=127.0.0.1
PG_PASSWORD=CHANGE_ME
PG_PORT=5433
PG_USER=postgres
SECRET_KEY=CHANGE_ME
SPARK_LOCAL_IP=127.0.0.1
SUPERSET_SECRET_KEY=CHANGE_ME
TRINO_HOST=127.0.0.1
TRINO_PORT=8081
VITE_API_URL=
VITE_SUPERSET_DASHBOARD_URL=
VITE_SUPERSET_URL=http://localhost:8088

# Additional source-consumed optional/runtime settings
AIRFLOW_WEBSERVER_URL=
CTU_IOC_API_BASE_URL=
CTU_IOC_API_KEY=CHANGE_ME
MINIO_URL=
NESSIE_DB=nessie_db
OPENMETADATA_HOST_PORT=
OPENMETADATA_JWT_TOKEN=CHANGE_ME
PG_MAINTENANCE_DB=postgres
TRINO_HTTP_URL=
URL_INGESTION_ENABLED=true
URL_CHECKSUM_DEDUP_ENABLED=false
GOOGLE_DRIVE_INGESTION_ENABLED=true
URL_IMPORT_MAX_ACTIVE_FILES=1
# Configure one option once at deployment. End users only paste Drive links.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_API_KEY=
