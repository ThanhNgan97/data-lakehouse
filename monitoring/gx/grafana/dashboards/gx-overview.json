{
  "title": "GX Production Overview",
  "uid": "gx-production",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "GX Up", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}, "targets": [{"expr": "up{job=\"gx-validator\"}"}]},
    {"id": 2, "type": "stat", "title": "Active validations", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}, "targets": [{"expr": "gx_active_validations"}]},
    {"id": 3, "type": "stat", "title": "Not configured", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}, "targets": [{"expr": "sum(increase(gx_not_configured_total[6h]))"}]},
    {"id": 4, "type": "timeseries", "title": "Validation latency p95", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(gx_validation_duration_seconds_bucket[5m])))"}]},
    {"id": 5, "type": "timeseries", "title": "Failures and quarantine", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 12}, "targets": [{"expr": "sum by (layer) (rate(gx_quality_failure_total[5m]))"}, {"expr": "sum by (reason) (rate(gx_quarantine_total[5m]))"}]}
  ]
}
