# Data Lakehouse environment contract
# Copy to .env and configure values for the target machine.
# Never commit real credentials.

AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_API_USERNAME=airflow
API_SOURCE_CREDENTIAL_KEY=CHANGE_ME
MOCK_API_PUBLIC_URL=http://localhost:8090
MOCK_API_INTERNAL_URL=http://ctu-ioc-mock-api:8000
MOCK_AUTH_REQUIRED=true
MOCK_API_USERNAME=lakehouse_test
MOCK_API_PASSWORD=Lakehouse@123
MOCK_API_TOKEN_SECRET=CHANGE_ME
MOCK_API_TOKEN_TTL_SECONDS=3600
AIRFLOW_UID=
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME
GX_CANDIDATE_SPARK_ENABLED=true
GX_SPARK_MASTER=local[2]
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODELS=gemini-3.5-flash-lite
HADOOP_HOME=
S3_ACCESS_KEY=lakehouse
S3_BUCKET_NAME=university-lakehouse
S3_ENDPOINT=http://127.0.0.1:9878
S3_REGION=us-east-1
STAGING_PREFIX=staging
ARCHIVE_PROCESSED_PREFIX=archive/processed
ARCHIVE_FAILED_PREFIX=archive/failed
ICEBERG_WAREHOUSE=s3a://university-lakehouse/iceberg-warehouse
ARCHIVE_RETENTION_DAYS=90
ARCHIVE_CLEANUP_ENABLED=false
ARCHIVE_CLEANUP_DRY_RUN=true
OZONE_VALIDATION_DAG_ID=ozone_read_validation
S3_SECRET_KEY=lakehouse-secret
MOCK_API_KEY=CHANGE_ME
NESSIE_API_URL=http://localhost:19120/api/v1
PG_DATABASE=university_db
PG_HOST=127.0.0.1
PG_PASSWORD=lakehouse-postgres
PG_PORT=5433
PG_USER=postgres
SECRET_KEY=CHANGE_ME
SPARK_LOCAL_IP=127.0.0.1
SUPERSET_SECRET_KEY=CHANGE_ME
TRINO_HOST=127.0.0.1
TRINO_PORT=8081
VITE_API_URL=
VITE_SUPERSET_DASHBOARD_URL=
VITE_SUPERSET_URL=http://localhost:8088
AIRBYTE_PORT=8006

# Additional source-consumed optional/runtime settings
AIRFLOW_WEBSERVER_URL=http://localhost:8080
CTU_IOC_API_BASE_URL=
CTU_IOC_API_KEY=CHANGE_ME
NESSIE_DB=nessie_db
OPENMETADATA_HOST_PORT=
OPENMETADATA_JWT_TOKEN=CHANGE_ME
PG_MAINTENANCE_DB=postgres
TRINO_HTTP_URL=
GX_NESSIE_BRANCH=
GX_ICEBERG_TABLE=
GX_TRINO_USER=gx-validator
GX_TRINO_CATALOG=lakehouse
GX_TRINO_SCHEMA=default
GX_RESULT_STORE_PREFIX=gx/validation-results
GX_DATA_DOCS_BASE_URL=s3://university-lakehouse/gx/data-docs
GX_TRINO_NESSIE_BRANCH=main
GX_ENVIRONMENT=development
GX_APPROVAL_SIGNING_KEY_ID=replace-with-production-key-id
GX_APPROVAL_PRIVATE_KEY=base64-encoded-32-byte-ed25519-private-key
GX_APPROVAL_PUBLIC_KEYS={"replace-with-production-key-id":"base64-encoded-32-byte-ed25519-public-key"}
GX_APPROVAL_REVOKED_KEY_IDS=
GX_APPROVAL_TTL_SECONDS=900
# Server-side caller-to-token keyring. A caller may temporarily have an array
# of tokens during rotation. Tokens must be unique and at least 32 characters.
GX_CALLER_CREDENTIALS={"airflow":{"token":"replace-with-airflow-random-token-at-least-32-chars","expires_at":"2099-01-01T00:00:00Z"},"gx-admin":{"token":"replace-with-admin-random-token-at-least-32-chars","expires_at":"2099-01-01T00:00:00Z"}}
# Inject this client credential only into the Airflow deployment.
GX_AIRFLOW_CALLER_TOKEN=replace-with-airflow-random-token-at-least-32-chars
GX_GOVERNANCE_CALLERS=gx-admin
GX_MAX_REQUEST_BYTES=65536
GX_ALLOW_PILOT_CONTRACTS=true
GX_ONBOARDING_PREFIX=gx/onboarding-proposals
GX_QUARANTINE_PREFIX=gx/quarantine
GX_RECEIPT_AUDIT_ENABLED=true
GX_RECEIPT_AUDIT_PREFIX=gx/receipt-consumption
GX_DELETE_PUBLISHED_CANDIDATE_BRANCH=true
GX_RETENTION_DRY_RUN=true
GX_RETENTION_MAX_DELETE=1000
GX_RETENTION_PREFIXES=gx/validation-results,gx/revocations,gx/quarantine,gx/onboarding-proposals,gx/receipt-consumption
GX_QUARANTINE_ACTIVE_RETENTION_DAYS=365
GX_PROMETHEUS_PORT=9090
GX_GRAFANA_PORT=3001
GX_GRAFANA_ADMIN_USER=admin
GX_GRAFANA_ADMIN_PASSWORD=replace-before-production
GX_SUITE_REVISION=
GX_RESULT_RETENTION_DAYS=90
GX_REDACT_OBSERVED_VALUES=true
GX_REVOCATION_PREFIX=gx/revocations
GX_OPENMETADATA_ENABLED=false
GX_OPENMETADATA_REQUIRED=false
GX_OPENMETADATA_TIMEOUT_SECONDS=10
GX_OPENMETADATA_API_STYLE=current
OPENMETADATA_SERVICE_NAME=lakehouse-trino
URL_INGESTION_ENABLED=true
URL_CHECKSUM_DEDUP_ENABLED=false
GOOGLE_DRIVE_INGESTION_ENABLED=true
URL_IMPORT_MAX_ACTIVE_FILES=1
# Configure one option once at deployment. End users only paste Drive links.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_API_KEY=
# GX gate for registered API datasets (Silver before Gold)
GX_API_GATE_MODE=enforce
GX_API_NESSIE_BRANCH=main
GX_API_GATE_TIMEOUT_SECONDS=300
# GX boundary for Airbyte/database relational runs
GX_DATABASE_GATE_MODE=enforce
GX_DATABASE_GATE_TIMEOUT_SECONDS=300
# GX validation for dbt-published Gold snapshots
GX_GOLD_GATE_MODE=enforce
GX_GOLD_NESSIE_BRANCH=main
GX_GOLD_GATE_TIMEOUT_SECONDS=300
# GX Silver-Gold reconciliation after dbt Gold validation
GX_RECONCILIATION_GATE_MODE=enforce
GX_RECONCILIATION_NESSIE_BRANCH=main
GX_RECONCILIATION_GATE_TIMEOUT_SECONDS=300
# Keep universal_lakehouse_pipeline during migration. Switch to
# file_upload_candidate_pipeline only after its acceptance run passes.
AIRFLOW_FILE_DAG_ID=universal_lakehouse_pipeline
